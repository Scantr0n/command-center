{
  "name": "command-center",
  "version": "0.1.0",
  "description": "Jack's unified project command center, one hub, one cluster per project",
  "main": "server.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/style.css --minify",
    "verify:css": "node scripts/verify-css.js",
    "build:vendor": "node scripts/build-vendor-d3.js",
    "start": "node server.js",
    "validate": "node data/clusters/validate.js && node public/cgt/data/validate.js && node public/csm/data/validate.js && node public/garage/data/validate.js && node public/alpha/data/validate.js && node public/sondrik/data/validate.js && node public/job-search/data/validate.js",
    "test:sondrik": "node --test public/sondrik/data/*.test.js",
    "test:cgt": "node --test public/cgt/data/*.test.js",
    "test:alpha": "node --test public/alpha/data/*.test.js",
    "test:garage": "node --test public/garage/data/*.test.js",
    "test:csm": "node --test public/csm/data/*.test.js",
    "test:job-search": "node --test public/job-search/data/*.test.js",
    "test:dashboard": "node --test public/data/*.test.js",
    "test:server": "node --test data/*.test.js",
    "test:sidebar": "node --test public/sidebar-core.test.js"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "compression": "^1.8.2",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^178.1.1"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
